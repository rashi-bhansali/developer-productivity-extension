{
  "manifest_version": 3,
  "name": "DevInks",
  "version": "3.0",
  "description": "Web-Linked Notes For Developers: Create and save notes and code snippets tied to specific websites for future reference.",
  "icons": {
    "16": "src/assets/DevInks.png",
    "32": "src/assets/DevInks.png",
    "48": "src/assets/DevInks.png",
    "128": "src/assets/DevInks.png"
  },
  "action": {
    "default_icon": "src/assets/DevInks.png"
  },
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "side_panel": {
    "default_path": "src/entry.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/js/pageLauncher.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/dashboard.html",
        "src/assets/DevInks.png",
        "src/styles/page-launcher.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
